# ── DB (착수보고서 261012: MySQL, 온프렘 유지 · VIP) ── 환경별 실제 주소는 overlays 에서 덮어씀
#  DB_HOST/DB_PORT : 서비스 DB 주소 + 시작 전 대기(initContainer) 주소
#  DB_JDBC_SCHEME/DB_DRIVER : DB 종류. 연습장(local)만 샘플 이미지 때문에 PostgreSQL 로 덮어씀
#  DB_PORT=6450 : MySQL Router 의 읽기/쓰기 자동 분할 포트 (8번 DB 구성도, 2026-10-16)
#   쓰기는 PRIMARY, 읽기는 SECONDARY 로 Router 가 나눔. DB 서버 직접(3306)이 아니라 Router 로 붙어야 장애 시 자동 전환됨
#   Keycloak 은 필요하면 6446(전부 PRIMARY)으로 바꿀 수 있게 8번에게 포트 개방 요청해 둠
#   DB_HOST 실제 주소는 overlays 에서 덮어씀 (onprem: Router 10.0.1.111 / aws-main: edge-proxy)
DB_HOST=mysql
DB_PORT=6450
DB_JDBC_SCHEME=mysql
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_DIALECT=org.hibernate.dialect.MySQLDialect
#  DB_NAME_SUFFIX : 서비스 DB 이름 뒤에 붙는 꼬리. 운영은 비움(productservice), 개발은 _dev(productservice_dev)
#   → 8번: MySQL 8.4 하나에서 개발·운영 DB 와 계정을 따로 둠 (계정은 namespace 별 db-secret 값으로 구분)
DB_NAME_SUFFIX=
# ── Keycloak (로그인 서버) ──
# KEYCLOAK_HOST/PORT 는 auth-service 가 시작 전에 Keycloak 을 기다릴 때 쓰는 주소 (아래 URL 들과 같이 바꿀 것)
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
# 토큰의 issuer(iss)는 브라우저가 보는 공개 주소 하나로 통일한다
#  - Keycloak 에 KC_HOSTNAME=<공개 주소>, KC_HOSTNAME_BACKCHANNEL_DYNAMIC=true 를 줘야 함 (연습장은 infra.sh 가 설정)
#  - JWT_ISSUER_URI : 백엔드가 토큰의 iss 와 비교하는 값 → 공개 주소 (KEYCLOAK_PUBLIC_SERVER_URL 과 같은 도메인)
#  - KEYCLOAK_JWK_SET_URI : 백엔드가 서명 키를 받는 주소 → 클러스터 내부 주소 (Pod 안에서는 공개 주소가 안 열릴 수 있음)
#    서비스 values 의 SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI 가 이 값을 씀
# 아래 공개 주소 3개는 기본값. 실제 값은 환경별 overlays 에서 덮어씀
KEYCLOAK_ISSUER_URI=http://keycloak.ecommerce.local/realms/ecommerce
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/ecommerce/protocol/openid-connect/certs
JWT_ISSUER_URI=http://keycloak.ecommerce.local/realms/ecommerce
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_SERVER_URL=http://keycloak.ecommerce.local
# ── Redis (4번) : 쿠폰 선착순 전용 Redis (apps/redis-coupon) ──
#  promotion 이 REDIS_HOST / REDIS_PORT / REDIS_PASSWORD(Secret redis-coupon-secret) 로 접속 (PR #14 의 앱 변수 이름 그대로)
#  쿠폰 처리 = 동기 방식: Redis Lua(중복 확인 → 차감 → pending 기록) → 당첨자만 요청 안에서 DB 저장 (2번 앱 코드, 10/22 확인)
#  같은 namespace 의 Service 이름이라 환경별 덮어쓰기 없음
#  aws-main 에는 redis-coupon 을 올리지 않는다 (쿠폰 경로는 온프렘 고정) → AWS promotion 은 발급만 503, 나머지 정상 (2번 확인)
REDIS_HOST=redis-coupon
REDIS_PORT=6379
# ── JPA ──
SPRING_JPA_HIBERNATE_DDL_AUTO=update
# ── JVM: 힙 200MB 제한 → 컨테이너 메모리 512Mi 안에 들어가게 ──
JAVA_TOOL_OPTIONS=-Xmx200m -Xms100m -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0
